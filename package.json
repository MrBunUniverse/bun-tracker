{
  "name": "slimevr",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "solarxr-protocol"
  ],
  "scripts": {
    "start": "bash \"Start SlimeVR.command\"",
    "build": "npm --prefix tauri-spike run build",
    "lint": "pnpm --dir tauri-spike/latest/gui lint",
    "lint:fix": "pnpm --dir tauri-spike/latest/gui lint:fix",
    "test": "pnpm --dir tauri-spike/latest/gui test",
    "update-solarxr": "cd solarxr-protocol && pnpm run build",
    "prepare": "husky && pnpm run update-solarxr",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  }
}
