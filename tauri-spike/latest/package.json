{
  "name": "slimevr",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "solarxr-protocol",
    "gui"
  ],
  "scripts": {
    "start": "pnpm --dir gui start",
    "build": "pnpm --dir gui build",
    "lint": "pnpm --dir gui lint",
    "lint:fix": "pnpm --dir gui lint:fix",
    "test": "pnpm --dir gui test",
    "update-solarxr": "cd solarxr-protocol && pnpm run build",
    "prepare": "husky && pnpm run update-solarxr",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  }
}
