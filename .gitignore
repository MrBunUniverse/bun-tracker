# Operating-system metadata
.DS_Store
*.DS_Store
.stignore

# IDE and editor state
.idea/
.fleet/
.project
.classpath
.settings/
/.vscode/settings.json
/.vscode/launch.json

# Java, Kotlin, Gradle, and Android local state
/.gradle/
/.kotlin/
/build/
local.properties

# JavaScript dependencies and package-manager caches
node_modules/
/.pnpm-store/

# Generated GUI and Tauri output (gui/app/.gitignore covers dist and stats.html)
/gui/tauri/target/
/gui/tauri/gen/

# Native tooling caches
/.cache/

# Nix and direnv local state
/.direnv/
/.devenv
/.bin/

# Runtime and temporary configuration
vrconfig.yml.tmp

# Local recovery data and generated analysis
/.backup/
*.bak
/.tools/
.impeccable/
/graphify-out/
/.context-shears/

# Claude Code local state. Shared rules and skills are tracked in .agents/.
/.claude/settings.local.json
/.claude/worktrees/
/.claude/rules/
/.claude/skills/
/.claude/settings.json.pre-restructure
/.claude/ui-map.md.pre-restructure
/.claude/slimevr-dev-skill-pre-restructure.tgz

# Full flash dumps hold Wi-Fi credentials; keep them local only.
firmware_backups/**/*.bin
